# Copy to .env.dev for local Poetry development. Keep .env for Beelink Compose.
OAKGATE_PUBLIC_URL=http://127.0.0.1:8801
OAKGATE_OIDC_ISSUER=https://keycloak.safebox.dev/realms/oakgate
OAKGATE_OIDC_CLIENT_ID=oakgate-web
OAKGATE_OIDC_CLIENT_SECRET=<paste the oakgate-web client secret from Keycloak>
# Empty uses temporary in-memory sessions for a single local development process.
OAKGATE_REDIS_URL=
