KC_BOOTSTRAP_ADMIN_USERNAME=admin
# Replace the placeholder with the output of: openssl rand -hex 24
KC_BOOTSTRAP_ADMIN_PASSWORD=<openssl rand -hex 24>

# Existing directory on the external storage drive (Docker host).
KEYCLOAK_DATA_DIR=/mnt/bitcoin/keycloak

# Public HTTPS origin served by Nginx (no /admin path).
KC_HOSTNAME=https://keycloak.safebox.dev
