# OakGate app: public HTTPS origin and Docker host binding.
# These host settings do not change the internal container port (8000).
OAKGATE_PUBLIC_URL=https://oakgate.safebox.dev
OAKGATE_BIND_ADDRESS=0.0.0.0
OAKGATE_PORT=8801

# Keycloak: public HTTPS origin and independent Docker host binding.
# Keycloak continues to listen on port 8080 inside its container.
KC_HOSTNAME=https://keycloak.safebox.dev
KEYCLOAK_BIND_ADDRESS=0.0.0.0
KEYCLOAK_PORT=8800

KC_BOOTSTRAP_ADMIN_USERNAME=admin
# Replace the placeholder with the output of: openssl rand -hex 24
KC_BOOTSTRAP_ADMIN_PASSWORD=<openssl rand -hex 24>

# Existing directory on the external storage drive (Docker host).
# Required existing host directory; Beelink: /mnt/lexar/keycloak
KEYCLOAK_DATA_DIR=

# OakGate's confidential Keycloak client; NOT the Google client secret.
OAKGATE_OIDC_ISSUER=https://keycloak.safebox.dev/realms/oakgate
OAKGATE_OIDC_CLIENT_ID=oakgate-web
OAKGATE_OIDC_CLIENT_SECRET=<paste the oakgate-web client secret from Keycloak>

# Durable encrypted Acorn custody. Back up this key separately from the data.
# Generate once: poetry run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAKGATE_CUSTODY_KEY=<generated Fernet key>
# Required existing host directory; Beelink: /mnt/lexar/oakgate
OAKGATE_DATA_DIR=
OAKGATE_BOOTSTRAP_RELAY=wss://spurline.safebox.dev
# Comma-separated exact relay URLs approved for server-side connections.
OAKGATE_ALLOWED_RELAYS=wss://spurline.safebox.dev

# New Acorn bootstrap mint and mint used for incoming Lightning payments.
# Compatibility mode matches Safebox Web; strict clients may require hash-bound invoices.
# Set strict mode true only with a compatible mint (see docs/009-lightning-receiving.md).
OAKGATE_REQUIRE_DESCRIPTION_HASH=false
# Pause new receiving requests AND background settlement during an isolated restore.
OAKGATE_PAYMENTS_ENABLED=true
OAKGATE_BOOTSTRAP_MINT=https://mint.safebox.dev
# Public zap receipts are also sent to safe public relays requested by the payer.
OAKGATE_ZAP_RELAYS=wss://relay.primal.net,wss://relay.damus.io,wss://nos.lol
OAKGATE_RECEIVE_MIN_SAT=1
OAKGATE_RECEIVE_MAX_SAT=1000000
OAKGATE_PAYMENT_POLL_SECONDS=5

# Stable OakGate instance identity, separate from custody and user Acorn keys.
# Generate once: openssl rand -hex 32 (hex or nsec accepted). Back up securely.
# Once bound to custody.sqlite3, removing/changing it prevents startup.
# Without it on a fresh instance, ordinary payments work but zaps are disabled.
OAKGATE_SERVICE_NSEC=
# Empty accepts signed card-recipient requests from any HTTPS-verified instance.
# Optional comma-separated service npubs restrict which instances may resolve cards.
OAKGATE_CARD_TRUSTED_INSTANCES=

# Fixed OakGate login session: one week. Activity does not extend it.
# Changes apply to new logins; logout or Redis restart ends sessions earlier.
OAKGATE_SESSION_TTL_SECONDS=604800

# Record attachments, temporary presentation/sharing copies, and public evidence checks.
OAKGATE_BLOSSOM_SERVER=https://grove.safebox.dev
OAKGATE_TRANSFER_SERVER=https://grove.safebox.dev
OAKGATE_OPENETR_RELAYS=wss://relay.openetr.org
# Public verifier links, bounded evidence queries, and public GS1 artifact sources.
OAKGATE_OPENETR_PUBLIC_BASE_URL=https://openetr.org/etr
OAKGATE_OPENETR_QUERY_TIMEOUT_SECONDS=5
OAKGATE_OPENETR_QUERY_LIMIT=100
OAKGATE_OPENETR_BLOSSOM_SERVERS=https://grove.safebox.dev
OAKGATE_RECORD_ALLOWED_SERVERS=https://grove.safebox.dev
# RECORD_ALLOWED_SERVERS may list additional trusted Safebox Web sharing servers.
# It does not authorize arbitrary servers embedded in scanned codes.

# Informational cash conversion, shared cached rates (same feed as Safebox Web).
OAKGATE_CURRENCY_RATES_ENABLED=true
OAKGATE_DEFAULT_CURRENCY=USD
OAKGATE_CURRENCY_RATE_SOURCE_URL=https://blockchain.info/ticker
OAKGATE_CURRENCY_RATE_INTERVAL_SECONDS=3600
OAKGATE_CURRENCY_RATE_STALE_SECONDS=86400

# Direct Safebox ecash reception runs without an active user session.
OAKGATE_ECASH_RECEIVE_ENABLED=true
OAKGATE_ECASH_POLL_SECONDS=30

# Automatically redeem incoming Clear transfers through Acorn while users are signed out.
# The inbox worker also requires OAKGATE_ECASH_RECEIVE_ENABLED=true.
OAKGATE_CLEAR_RECEIVE_ENABLED=true

# Public service ownership label only; this does not commission the service.
# Use mainstay-managed only when Mainstay manages this deployment.
OAKGATE_SERVICE_MANAGEMENT=independent

# Separate receive-only POS service (device activation available; payments coming next).
# Start explicitly with ./refresh-pos.sh; routine app refresh leaves POS alone.
OAKGATE_POS_ENABLED=false
OAKGATE_POS_PUBLIC_URL=https://pos.oakgate.safebox.dev
# Loopback when Nginx is on Beelink; choose a VPN IP or 0.0.0.0 for a remote proxy.
OAKGATE_POS_BIND_ADDRESS=127.0.0.1
OAKGATE_POS_PORT=8804
# Docker-internal OakGate origin. Do not point this at the POS hostname.
OAKGATE_POS_API_URL=http://app:8000
# Required when enabled; generate separately from OAKGATE_CUSTODY_KEY:
# poetry run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAKGATE_POS_COOKIE_KEY=

# Optional Keycloak NFC login. See docs/027-keycloak-nfc-login.md before enabling.
OAKGATE_NFC_LOGIN_ENABLED=false
OAKGATE_NFC_CLIENT_ID=oakgate-nfc
# Secret of the separate confidential Keycloak client, not oakgate-web.
OAKGATE_NFC_CLIENT_SECRET=
# Generate independently: openssl rand -hex 32
OAKGATE_NFC_BACKCHANNEL_SECRET=
# When enabled, persist the override for ALL compose/refresh commands:
# COMPOSE_FILE=compose.yaml:compose.nfc.yaml

# Private PostgreSQL infrastructure. Provisioning alone migrates neither app nor Keycloak.
# Required existing, dedicated host directory. Beelink: /mnt/lexar/oakgate-postgres
OAKGATE_POSTGRES_DATA_DIR=
OAKGATE_POSTGRES_DB=oakgate
# Bootstrap administrator only; not a future application runtime role.
OAKGATE_POSTGRES_USER=oakgate_admin
# Generate once independently: openssl rand -hex 32
# Initial setup only: changing .env later does not rotate the database password.
OAKGATE_POSTGRES_PASSWORD=

# Controlled PostgreSQL runtime cutover: leave blank while SQLite is authoritative.
# Requires compose.postgres.yaml and a migrated target. Never use oakgate_admin here.
# URL-encode passwords; a generated hex password avoids URL punctuation.
OAKGATE_DATABASE_URL=
# Migration credentials are supplied only to explicit one-off maintenance commands
# as OAKGATE_MIGRATION_DATABASE_URL, never to the normal app or POS.
# After verified PostgreSQL cutover, persist overrides so refreshes keep using it:
# COMPOSE_FILE=compose.yaml:compose.nfc.yaml:compose.postgres.yaml
# Preserve other overrides; omit compose.nfc.yaml only if NFC login is not used.

# Optional Keycloak PostgreSQL migration: docs/034-keycloak-postgresql.md.
# Adding these values alone does not change Keycloak's database or start mode.
# Separate from OakGate's database and runtime/migration roles.
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak
# Generate independently: openssl rand -hex 32
KEYCLOAK_POSTGRES_PASSWORD=
# New work/export directory, NOT the H2 source or PostgreSQL cluster directory.
# Example: /mnt/lexar/keycloak-postgres-work
KEYCLOAK_POSTGRES_WORK_DIR=
# Only at the controlled Keycloak migration step, append the new override:
# COMPOSE_FILE=compose.yaml:compose.nfc.yaml:compose.postgres.yaml:compose.keycloak-postgres.yaml
