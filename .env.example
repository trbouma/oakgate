# OakGate app: public HTTPS origin and Docker host binding.
# These host settings do not change the internal container port (8000).
OAKGATE_PUBLIC_URL=https://oakgate.safebox.dev
OAKGATE_BIND_ADDRESS=0.0.0.0
OAKGATE_PORT=8801

# Keycloak: public HTTPS origin and independent Docker host binding.
# Keycloak continues to listen on port 8080 inside its container.
KC_HOSTNAME=https://keycloak.safebox.dev
KEYCLOAK_BIND_ADDRESS=0.0.0.0
KEYCLOAK_PORT=8800

KC_BOOTSTRAP_ADMIN_USERNAME=admin
# Replace the placeholder with the output of: openssl rand -hex 24
KC_BOOTSTRAP_ADMIN_PASSWORD=<openssl rand -hex 24>

# Existing directory on the external storage drive (Docker host).
KEYCLOAK_DATA_DIR=/mnt/bitcoin/keycloak

# OakGate's confidential Keycloak client; NOT the Google client secret.
OAKGATE_OIDC_ISSUER=https://keycloak.safebox.dev/realms/oakgate
OAKGATE_OIDC_CLIENT_ID=oakgate-web
OAKGATE_OIDC_CLIENT_SECRET=<paste the oakgate-web client secret from Keycloak>
